# ── Catalyst Innovations — environment configuration ─────────────────
# Copy to .env.local for development. Never commit real values.

# Canonical site URL (used for SEO metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Public contact details (leave empty until official accounts exist —
# the UI gracefully shows "coming soon" placeholders when unset)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# Consultation form delivery — configure either or both:
# 1) Webhook (CRM / Zapier / Make): receives the submission as JSON
CONSULTATION_WEBHOOK_URL=
# 2) Email via Resend (resend.com): free tier is fine to start
RESEND_API_KEY=
CONSULTATION_TO_EMAIL=
CONSULTATION_FROM_EMAIL=

# Scheduling link (Calendly, SavvyCal, …) — shown after form submission
NEXT_PUBLIC_SCHEDULING_URL=

# Analytics — set one (or both) and tracking activates automatically
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=

# Headless CMS (Sanity) — set both and Solutions/Industries/Portfolio pages
# fetch live content instead of data/*.ts. See lib/cms.ts for the expected
# schema. Leave blank to keep editing content by committing to the data files.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Production error reporting — any ingestion endpoint that accepts a JSON
# POST. Leave blank and errors just go to server/browser console logs.
NEXT_PUBLIC_ERROR_WEBHOOK_URL=

# Durable rate limiting for the consultation form (Upstash Redis free tier —
# upstash.com). Leave blank and it falls back to an in-memory limiter, which
# is fine for a single instance but resets on every redeploy.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Search Console ownership verification. Get this from Search Console
# -> Settings -> Ownership verification -> HTML tag -> copy just the
# "content" value (not the whole tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
