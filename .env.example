# Copy to .env.local for development. Enter production secrets in DigitalOcean.
NEXT_PUBLIC_SITE_URL=https://mycatalystinnovations.com
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_SCHEDULING_URL=

# Required: a webhook OR all three Resend settings.
# Webhook receives validated JSON and must accept it with a 2xx response.
# Resend requires a verified sender. Missing configuration returns a recoverable 503.
CONSULTATION_WEBHOOK_URL=
RESEND_API_KEY=
CONSULTATION_TO_EMAIL=
CONSULTATION_FROM_EMAIL=

# Optional analytics: loads only after visitor consent. Never send form contents.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=

# Optional CMS; leave unset to use versioned content in data/.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Optional same-origin diagnostics: receives only type, path and timestamp.
NEXT_PUBLIC_ERROR_WEBHOOK_URL=
# Optional shared rate limiter; otherwise bounded per-instance memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Sites builds inject SITE_PREVIEW=true. Never set it for public production.
